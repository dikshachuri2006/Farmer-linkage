# ==============================================================================
# SIH26132 - Farmer Market Linkage & Price Discovery Backend
# Environment Configuration Template (.env.example)
# IMPORTANT: Copy this to .env and configure local values. NEVER commit secrets.
# ==============================================================================

# Project & Runtime Environment
PROJECT_NAME="Farmer Market Linkage & Price Discovery API"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api

# Security & Authentication (JWT)
# Generate a strong key with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration (Managed by Ankita)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=farmer_linkage_db

# Optional direct connection string override:
# DATABASE_URL=postgresql+psycopg://postgres:your_secure_db_password_here@localhost:5432/farmer_linkage_db

# CORS Configuration for Frontend (Diksha)
# JSON-encoded array of allowed origins (e.g. Vite or React development servers)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5500","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:5500","http://127.0.0.1:8080"]

# Transport & Net Realization Engine Parameters
DEFAULT_TRANSPORT_RATE_PER_KM_PER_KG=0.05
BASE_TRANSPORT_CHARGE=150.0

# Optional External Maps / Distance API (Defaults to Haversine/heuristic calculation)
MAPS_API_KEY=
